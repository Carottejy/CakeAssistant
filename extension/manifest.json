{
  "manifest_version": 3,
  "name": "Cake Assistant",
  "short_name": "Cake Assistant",
  "version": "1.0.0",
  "description": "Enregistre en un clic les recettes de pâtisserie dans ton carnet Cake Assistant.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Enregistrer dans Cake Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Ouvrir Cake Assistant"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mtgkssbxpetijngddbiu.supabase.co/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "cake-assistant@carottejy",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  }
}
